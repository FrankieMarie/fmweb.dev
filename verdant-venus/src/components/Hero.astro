---
import { ArrowDown } from "@lucide/astro";
---

<style>
  .hero {
    height: calc(100vh - 7.75rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .h1 {
    margin-top: 20%;
    text-transform: uppercase;
    color: var(--grey);
    letter-spacing: .25em;
    font-weight: 400;
    margin-bottom: 2rem;
  }

  .heading-text {
    color: var(--white-opacity);
    text-transform: uppercase;
    font-size: clamp(3rem, 5vw, 6rem);
    font-weight: 500;
    letter-spacing: .025em;
    text-align: center;
    flex: 1;
  }

  .cta-btn {
    margin: 1rem 0;
    background: none;
    border: none;
    text-transform: uppercase;
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--white);
    font-size: 1.5em;
    font-weight: 300;

    span {
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: var(--gold);
      color: var(--bg);
      border-radius: 4px;
      padding: .15rem .25rem;
    }
  }
</style> 

<section class="content-container hero">
  <h1 class="h1">Hi, I'm Frankie</h1>
  <p class="heading-text">I build websites<br/>and web applications</p>
  <button class="cta-btn">Discover More <span><ArrowDown/></span></button>
</section>