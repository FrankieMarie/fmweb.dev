---
import { Megaphone } from "@lucide/astro";
---

<style>
  .banner {
    background: linear-gradient(90deg, var(--gold-dark) 0%, var(--gold) 25%, var(--gold) 65%, var(--gold-light) 100%);
    padding: var(--size-12) 0;
    color: var(--bg);
    font-size: var(--size-14);

    .message {
      display: flex;
      align-items: center;
      text-align: center;
      justify-content: center;
      gap: var(--size-8);
      padding: 0 clamp(var(--size-24), 5vw, var(--size-64));
    }

    p { text-transform: uppercase; }

    svg {
      color: var(--bg);
      width: var(--size-18);
    }
 }
</style>

<div class="banner">
  <div class="content-container message">
    <Megaphone/> <p>Available for freelance</p>
  </div>
</div>