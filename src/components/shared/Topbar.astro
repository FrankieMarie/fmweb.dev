<style>

  .topbar {
    font-family: "Atkinson", sans-serif;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--size-24) var(--size-8) 0 var(--size-8);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .blog-link {
    font-size: .75rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: .5rem 1rem;
    border-radius: 20px;
  }

  .typewriter {
    display: inline-block;
    font-size: .75rem;
    line-height: 2;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: .5rem 1rem;
    border-radius: 20px;
  }

  .typewriter-char {
    display: inline-block;
    opacity: 0;
    color: var(--white);
  }

</style>

<div class="content-container topbar">
  <a href="/" class="typewriter" id="typewriter-text"></a>
  <nav class="nav">
    <a href="/blog" class="blog-link">Blog</a>
  </nav>
</div>

<script>
  import { animate, stagger } from "motion";

  const text = "Frankie Marie";
  const container = document.getElementById('typewriter-text');
  
  if (container) {
    // Function to run typewriter animation
    const runTypewriter = () => {
      // Clear container completely
      container.innerHTML = '';
      
      // Create fresh character spans
      const chars = text.split('').map(char => {
        const span = document.createElement('span');
        span.className = 'typewriter-char';
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.opacity = '0';
        return span;
      });
      
      // Append characters
      chars.forEach(char => container.appendChild(char));
      
      // Animate with slight delay
      setTimeout(() => {
        animate(
          chars,
          { opacity: 1 },
          { 
            delay: stagger(0.08),
            duration: 0.001
          }
        );
      }, 50);
    };
    
    // Function to clear text
    const clearText = () => {
      container.innerHTML = '';
    };
    
    // Intersection Observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            runTypewriter();
          } else {
            clearText();
          }
        });
      },
      { threshold: 0.3 }
    );
    
    observer.observe(container);
    
    // Run initially
    runTypewriter();
  }
</script>

