<style> 
  .stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100vh;
    pointer-events: none;
  }
</style>

<canvas class="stars" data-speed=".4">
  Your browser does not support the HTML canvas tag.
</canvas>

<script is:inline>
  (() => {
    const canvas = document.currentScript.previousElementSibling;
    if (!canvas) return;

    const starDensity = 0.00015;
    const allStarsTwinkle = true;
    const twinkleProbability = 0.75;
    const minTwinkleSpeed = 0.75;
    const maxTwinkleSpeed = 1;

    /** @typedef {{x:number,y:number,radius:number,opacity:number,twinkleSpeed:number|null}} Star */
    /** @type {Star[]} */
    let stars = [];

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const generateStars = (width, height) => {
      const area = width * height;
      const numStars = Math.floor(area * starDensity);
      return Array.from({ length: numStars }, () => {
        const shouldTwinkle = allStarsTwinkle || Math.random() < twinkleProbability;
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          radius: Math.random() * 0.05 + 0.5,
          opacity: Math.random() * 0.5 + 0.5,
          twinkleSpeed: shouldTwinkle
            ? minTwinkleSpeed + Math.random() * (maxTwinkleSpeed - minTwinkleSpeed)
            : null
        };
      });
    };

    const updateStars = () => {
      const width = window.innerWidth;
      const height = Math.max(document.documentElement.scrollHeight, window.innerHeight);
      canvas.width = width;
      canvas.height = height;
      canvas.style.height = `${height}px`;
      stars = generateStars(width, height);
    };

    const resizeObserver = new ResizeObserver(updateStars);
    resizeObserver.observe(canvas);

    updateStars();

    let animationFrameId;
    const render = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      stars.forEach((star) => {
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,252,255,${star.opacity})`;
        ctx.fill();
        if (star.twinkleSpeed !== null) {
          star.opacity = 0.5 + Math.abs(Math.sin((Date.now() * 0.001) / star.twinkleSpeed) * 0.5);
        }
      });
      animationFrameId = requestAnimationFrame(render);
    };
    render();
  })();
</script>

<style>
  /* Ensure the canvas does not capture pointer events and stays behind content */
  :host > canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
  }
</style>
