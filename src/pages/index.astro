---
import Page from "../layouts/Page.astro";
import Hero from "../components/Home/Hero.astro";
import About from "../components/Home/About.astro";
---

<Page
  title="FM Web Dev"
  description="Interactive web development"
  snapScroll
>
  <Hero />
  <About />
</Page>

<style is:global>
  #scroll-content {
    display: flex;
    flex-direction: column;
    min-height: 200dvh;
  }

  #scroll-content main {
    display: contents;
  }
</style>

<script>
  import { createSnapScroll } from '../scripts/snapScroll';
  createSnapScroll();
</script>

