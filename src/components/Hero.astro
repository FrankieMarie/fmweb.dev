---
import { ArrowDown } from "@lucide/astro";
---

<style>
  .hero {
    height: calc(100vh - 3.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .heading {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
  }

  .heading-text {
    text-transform: uppercase;
    text-align: right;
  }

  .heading-subtext {
    text-transform: uppercase;
    text-align: right;
  }

  .cta-text {
    font-weight: 500;
    color: var(--grey);
    letter-spacing: .15em;
    text-transform: uppercase;
    font-size: .75rem;
    margin-bottom: 1rem;
  } 

  .cta-btn {
    margin: 1rem 0 2rem 0;
    background: none;
    border: none;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--gold);
    color: var(--bg);
    border-radius: 4px;
    padding: .15rem .25rem;
  }
</style> 

<section class="content-container hero">
  <div class="heading">
    <h1 class="heading-text">
      <span class="fm">FM</span><span class="web">Web</span><span class="dev">Dev</span>
    </h1>
    <p class="heading-subtext">Interactive web design and development</p>
  </div>
  <span class="cta-text">Discover More</span>
</section>
