---
const { fixed } = Astro.props;
---

<style>
  footer {
    position: relative;
    z-index: 1;
    color: var(--white);
    font-size: .85rem;
    font-family: "Adwaita Sans", sans-serif;
    text-align: left;
    width: 100%;
    padding: 0 var(--size-8) var(--size-24) var(--size-8);

    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  footer.fixed {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    pointer-events: none;
  }

  footer.fixed a {
    pointer-events: auto;
  }

  span {
    justify-self: start;
    padding: .5rem 1rem;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: var(--size-8);
    justify-self: end;
    align-self: end;

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.25s ease-in-out;
      border-radius: 9999px;
      padding: 0.5rem;
    }

    svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

</style>

<footer class:list={["inter-200 content-container", { fixed }]}>
  <span>&copy; FM Web Dev &ndash; {new Date().getFullYear()}</span>
  <ul class="socials">
    <li><a href="https://codepen.io/frankiemarie" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/><polyline points="2 15.5 12 8.5 22 15.5"/><line x1="12" y1="2" x2="12" y2="8.5"/></svg></a></li>
    <li><a href="https://github.com/FrankieMarie" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a></li>
    <li><a href="https://www.linkedin.com/in/frankiedenell/" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a></li>
  </ul>
</footer>