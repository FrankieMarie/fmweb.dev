---
import { ArrowDown } from "@lucide/astro";
import SectionHeading from "./SectionHeading.astro";
---

<style>
  .hero {
    height: calc(100vh - 7.75rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .h1 {
    margin-bottom: 2rem;
  }

  .heading-text {
    color: var(--white);
    text-transform: uppercase;
    font-size: clamp(3rem, 5vw, 6rem);
    font-weight: 500;
    letter-spacing: .025em;
    text-align: center;
  }

  .scramble-typewriter {
    font-weight: 200;
    color: var(--grey);
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .cta-btn {
    margin: 2rem 0;
    background: none;
    border: none;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--gold);
    color: var(--bg);
    border-radius: 4px;
    padding: .15rem .25rem;
  }
</style> 

<script src="./scramble-type.ts"></script>

<section class="content-container hero">
  <div class="heading">
    <SectionHeading text="Hi, I'm Frankie" style={{'margin-bottom': '2rem'}}/>
    <p class="heading-text">I build websites<br/>and web applications</p>
  </div>
  <span class="scramble-typewriter"></span>
  <button class="cta-btn"><ArrowDown/></button>  
</section>