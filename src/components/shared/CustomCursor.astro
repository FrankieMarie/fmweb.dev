<span id="circle" class="circle"></span>

<style>
  .circle {
    position: fixed;
    top: 0;
    left: 0;
    border: 2px solid var(--gold);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    will-change: transform, width, height, border-radius;
    transition:
      width 0.4s ease,
      height 0.4s ease,
      border-radius 0.4s ease;
  }

  /* Hide circle on touch devices */
  @media (pointer: coarse) {
    .circle {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Check if it's a mobile touch device (not desktop with touchscreen)
    const isMobileTouch =
      /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
        navigator.userAgent
      );

    // Only initialize on non-mobile devices
    if (!isMobileTouch) {
      let mouseX = 0,
        mouseY = 0;
      let xp = 0,
        yp = 0;
      let targetScale = 0;
      let currentScale = 0;
      const circle = document.getElementById("circle");
      let hoveredElement = null;
      let isHovering = false;
      let cachedElements = [];
      let debounceTimer = null;

      if (!circle) return;

      // Hide circle initially (scale to 0)
      circle.style.transform = "translate(0px, 0px) scale(0)";

      // Show circle on mousemove (works reliably in all browsers)
      document.addEventListener(
        "mousemove",
        function (e) {
          targetScale = 1;
          if (!isHovering) {
            mouseX = e.clientX - 20; // Offset by half the circle size (40px / 2)
            mouseY = e.clientY - 20;
          }
        },
        { passive: true }
      );

      // Hide circle when mouse leaves the page (use documentElement for Firefox compatibility)
      document.documentElement.addEventListener("mouseleave", function () {
        targetScale = 0;
      });

      // Function to attach hover listeners to interactive elements
      function attachHoverListeners() {
        // Clear old listeners by caching elements
        cachedElements = Array.from(
          document.querySelectorAll('a, button, [role="button"]')
        );

        cachedElements.forEach((element) => {
          // Remove old listeners if they exist
          element._cursorMouseEnter = () => {
            isHovering = true;
            hoveredElement = element;

            const rect = element.getBoundingClientRect();
            const computedStyle = window.getComputedStyle(element);

            // Get element's border radius
            const borderRadius = computedStyle.borderRadius || "4px";

            // Update circle to match element
            circle.style.width = rect.width + "px";
            circle.style.height = rect.height + "px";
            circle.style.borderRadius = borderRadius;

            // Set position to element position (using viewport coordinates)
            mouseX = rect.left;
            mouseY = rect.top;
          };

          element._cursorMouseLeave = () => {
            isHovering = false;
            hoveredElement = null;

            // Return to circle shape
            circle.style.width = "40px";
            circle.style.height = "40px";
            circle.style.borderRadius = "50%";
          };

          element.addEventListener("mouseenter", element._cursorMouseEnter);
          element.addEventListener("mouseleave", element._cursorMouseLeave);
        });
      }

      // Initial attachment
      attachHoverListeners();

      // Debounced re-attach when DOM changes
      const observer = new MutationObserver(() => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(attachHoverListeners, 100);
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true,
      });

      // Use requestAnimationFrame for smooth 60fps animation
      function animate() {
        // If hovering an element, track its position
        if (isHovering && hoveredElement) {
          const rect = hoveredElement.getBoundingClientRect();
          mouseX = rect.left;
          mouseY = rect.top;
        }

        // Smooth lag effect for position
        xp += (mouseX - xp) / 6;
        yp += (mouseY - yp) / 6;

        // Smooth interpolation for scale
        currentScale += (targetScale - currentScale) / 4;

        // Use transform for GPU acceleration (no layout reflow)
        circle.style.transform =
          "translate(" + xp + "px, " + yp + "px) scale(" + currentScale + ")";

        requestAnimationFrame(animate);
      }

      // Start animation loop
      animate();
    }
  })();
</script>
