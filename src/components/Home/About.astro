---
import SectionHR from "./SectionHR.astro";
---

<style>
  .about {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    flex: 1;

    .bio-heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    h2 {
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .bio-paragraph {
      font-size: 1rem;
      max-width: 37.5rem;
      margin: 0 auto;
      width: 100%;
      padding: 0 calc(var(--size-8) + 1rem);
    }

    .bio-link {
      color: var(--accent);
      transition: color 0.25s ease-in-out;
      padding: .25rem;
      border-radius: 0.5rem;
    }
  }

  @media (width < 37.5rem) {
    .about .bio-paragraph {
      font-size: calc(14 * var(--fluid));
    }
  }
</style> 

<section class="about" id="about" data-snap-section>
  <div class="bio-heading">
    <SectionHR />
    <h2 class="inter-200">Bio</h2>
  </div>
  <p class="bio-paragraph">
    I’ve spent nearly a decade as a professional web developer, working across front-end apps, UI/UX, interactive experiences, and API and server-side engineering. I enjoy building thoughtful, performant applications where design and engineering meet.
  </p>
  <p class="bio-paragraph">
    Currently, I develop web applications at<a class="bio-link" href="https://www.tilt.com" target="_blank" rel="noopener noreferrer">Tilt</a>.
  </p>
</section>
