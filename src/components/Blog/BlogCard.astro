---
import FormattedDate from "./FormattedDate.astro";

type Props = {
  post: {
    id: string;
    data: {
      title: string;
      pubDate: Date;
      description: string;
      topics: string[];
    };
  };
};

const { post } = Astro.props;
---

<a class="hvr-backward" href={`/blog/${post.id}/`}>
  <h2 class="title">{post.data.title}</h2>
  <p class="summary">{post.data.description}</p>
  <div class="post-data">
    <p class="date">
      <FormattedDate date={post.data.pubDate} />
    </p>
    <p class="tags">{post.data.topics.map((topic) => topic).join(", ")}</p>
  </div>
</a>

<style>
  a {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    height: 100%;
    text-decoration: none;
    color: var(--white);
  }

  .title {
    padding: 16px 16px 0 16px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 20px 20px 0 0;
    width: 100%;
  }

  .summary {
    padding: 8px 16px 16px 16px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    font-weight: normal;
    flex-grow: 1;
  }

  .post-data {
    display: grid;
    gap: 2px;
    grid-template-columns: 1fr 1fr;
    margin-top: 2px;

    p {
      padding: 16px;
      background: rgba(255, 255, 255, 0.1);
      text-align: center;
    }

    .date {
      border-radius: 0 0 0 20px;
      color: var(--pink);
    }

    .tags {
      border-radius: 0 0 20px 0;
      color: var(--yellow);
    }
  }
</style>
