---
import { Code } from "astro:components";
interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = "bash", title } = Astro.props;

const habamax = {
  name: "habamax",
  type: "dark" as const,
  settings: [
    // Default
    {
      settings: {
        foreground: "#bcbcbc",
        background: "transparent",
      },
    },
    // Comment
    {
      scope: ["comment", "punctuation.definition.comment"],
      settings: { foreground: "#767676" },
    },
    // String
    {
      scope: ["string", "string.quoted", "string.template"],
      settings: { foreground: "#5faf5f" },
    },
    // Character
    {
      scope: ["constant.character", "constant.character.escape"],
      settings: { foreground: "#87d787" },
    },
    // Constant (numbers, booleans, language constants)
    {
      scope: [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
      ],
      settings: { foreground: "#d75f87" },
    },
    // Keyword / Statement
    {
      scope: [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier",
      ],
      settings: { foreground: "#af87af" },
    },
    // Operator / Punctuation
    {
      scope: [
        "keyword.operator",
        "punctuation",
        "meta.brace",
      ],
      settings: { foreground: "#bcbcbc" },
    },
    // Identifier / Variable
    {
      scope: [
        "variable",
        "variable.parameter",
        "variable.other",
        "entity.name.tag",
      ],
      settings: { foreground: "#87afaf" },
    },
    // Function
    {
      scope: [
        "entity.name.function",
        "support.function",
        "meta.function-call",
      ],
      settings: { foreground: "#bcbcbc" },
    },
    // Type
    {
      scope: [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
      ],
      settings: { foreground: "#5f87af" },
    },
    // Attribute name / PreProc
    {
      scope: [
        "entity.other.attribute-name",
        "meta.preprocessor",
        "entity.name.function.decorator",
        "meta.decorator",
      ],
      settings: { foreground: "#af875f" },
    },
    // Special
    {
      scope: [
        "support.other",
        "meta.object-literal.key",
        "punctuation.definition.template-expression",
      ],
      settings: { foreground: "#5f8787" },
    },
    // Markup
    {
      scope: ["markup.heading"],
      settings: { foreground: "#bcbcbc", fontStyle: "bold" },
    },
    {
      scope: ["markup.italic"],
      settings: { fontStyle: "italic" },
    },
    {
      scope: ["markup.bold"],
      settings: { fontStyle: "bold" },
    },
  ],
};
---

<div class="code-snippet">
  {title && <div class="code-title">{title}</div>}
  <div class="code-body">
    <Code code={code.trim()} lang={lang as any} theme={habamax} />
    <button class="copy-btn" data-code={code.trim()} aria-label="Copy code">
      <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') ?? '';
      await navigator.clipboard.writeText(code);
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 2000);
    });
  });
</script>

<style>
  .code-snippet {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    margin: 1.5rem 0;
    font-size: var(--size-14);
    background: rgba(255, 255, 255, 0.1);
  }

  .code-title {
    background: rgba(255, 255, 255, 0.05);
    color: #808080;
    padding: 0.4rem 1rem;
    font-size: var(--size-12);
    font-family: "Atkinson", sans-serif;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    letter-spacing: 0.05em;
  }

  .code-body {
    position: relative;
  }

  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #767676;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s, border-color 0.2s;
  }

  .copy-btn:hover {
    color: #bcbcbc;
    border-color: #585858;
  }

  .copy-btn .icon-check {
    display: none;
  }

  .copy-btn.copied .icon-copy {
    display: none;
  }

  .copy-btn.copied .icon-check {
    display: block;
    color: #5faf5f;
  }

  .code-body :global(pre) {
    margin: 0;
    padding: 1rem;
    border-radius: 0;
    overflow-x: auto;
  }

  .code-body :global(code) {
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo,
      Consolas, "DejaVu Sans Mono", monospace;
    font-size: var(--size-14);
    line-height: 1.6;
  }
</style>
