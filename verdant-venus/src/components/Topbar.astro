---
import { Codepen } from "@lucide/astro";
import { Github } from "@lucide/astro";
import { Linkedin } from "@lucide/astro";
---

<script>
  const logo = document.getElementById('logo');
  if (logo) {
    logo.style.cursor = 'pointer';
    logo.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<div class="content-container topbar">
  <nav class="nav">
    <h1 id="logo">FM<span class="web">WEB</span><span>DEV</span></h1>
    <ul class="nav-links">
      <li><a href="/">About</a></li>
      <li><a href="/">Projects</a></li>
      <li><a href="/">Contact</a></li>
    </ul>
    <ul class="socials">
      <li><a href="https://codepen.io/fmwebdev"><Codepen /></a></li>
      <li><a href="https://github.com/fmwebdev"><Github /></a></li>
      <li><a href="https://www.linkedin.com/in/fmwebdev/"><Linkedin /></a></li>
    </ul>
  </nav>
</div>

