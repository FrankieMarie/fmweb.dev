<style>
  .hero {
    height: 100dvh;
    flex-shrink: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }

  .heading-text {
    text-align: center;
    white-space: nowrap;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(var(--size-8) + 1rem);
    font-size: calc((100vw - 2 * (var(--size-8) + 1rem)) * 0.167);
    line-height: 1.1;
    font-family: 'Portico', sans-serif;
    font-weight: normal;
  }

  .fm,
  .web,
  .dev {
    position: relative;
    display: inline-block;
  }

  .fm {
    color: transparent;
    -webkit-text-stroke: 1.75px var(--grey);
    text-stroke: 1.75px var(--grey);
  }

  .fm::before {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    color: transparent;
    -webkit-text-stroke: 1.75px var(--accent);
    text-stroke: 1.75px var(--accent);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      circle var(--radius, 0px) at var(--x, -100px) var(--y, -100px),
      rgba(0, 0, 0, var(--opacity, 0)) 70%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle var(--radius, 0px) at var(--x, -100px) var(--y, -100px),
      rgba(0, 0, 0, var(--opacity, 0)) 70%,
      transparent 100%
    );
  }

  .web,
  .dev {
    color: transparent;
    -webkit-text-stroke: 1.75px var(--grey);
    text-stroke: 1.75px var(--grey);
  }

  .web::before,
  .dev::before {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    color: transparent;
    -webkit-text-stroke: 1.75px var(--white);
    text-stroke: 1.75px var(--white);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      circle var(--radius, 0px) at var(--x, -100px) var(--y, -100px),
      rgba(0, 0, 0, var(--opacity, 0)) 70%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle var(--radius, 0px) at var(--x, -100px) var(--y, -100px),
      rgba(0, 0, 0, var(--opacity, 0)) 70%,
      transparent 100%
    );
  }

  .heading-subtext {
    text-align: right;
    padding: .5rem 0;
    font-size: calc(18 * var(--fluid));
  }

  .cta-text {
    color: var(--accent);
    font-size: calc(16 * var(--fluid));
    margin-bottom: var(--size-24);
    padding: .5rem 1rem;
    border-radius: 9999px;
    transition: color 0.25s ease-in-out;
  }

  @media (width < 37.5rem) {
    .heading {
      align-items: center;
    }

    .heading-subtext {
      text-align: center;
    }

    .cta-text {
      margin-bottom: calc(84 * var(--fluid));
    }
  }
</style>

<script>
  const heading = document.querySelector('.heading-text');
  const elements = Array.from(document.querySelectorAll('.fm, .web, .dev')) as HTMLElement[];
  
  if (heading && elements.length) {
    const states = elements.map(() => ({ 
      currOpacity: 0, 
      targetOpacity: 0,
      currRadius: 0,
      targetRadius: 0,
      hasEntered: false
    }));
    const MAX_RADIUS = 170;
    const LERP_OPACITY = 0.2;
    const LERP_RADIUS = 0.25;
    let rafId = 0;
    
    const animate = () => {
      let needsUpdate = false;
      
      elements.forEach((el, i) => {
        const s = states[i];
        
        // Animate opacity
        if (Math.abs(s.targetOpacity - s.currOpacity) > 0.01) {
          s.currOpacity += (s.targetOpacity - s.currOpacity) * LERP_OPACITY;
          el.style.setProperty('--opacity', s.currOpacity.toFixed(3));
          needsUpdate = true;
        }
        
        // Animate radius growth
        if (Math.abs(s.targetRadius - s.currRadius) > 0.5) {
          s.currRadius += (s.targetRadius - s.currRadius) * LERP_RADIUS;
          el.style.setProperty('--radius', `${s.currRadius}px`);
          needsUpdate = true;
        }
      });
      
      rafId = needsUpdate ? requestAnimationFrame(animate) : 0;
    };
    
    heading.addEventListener('mousemove', (e) => {
      const { clientX, clientY } = e as MouseEvent;
      
      elements.forEach((el, i) => {
        const { left, top, width, height } = el.getBoundingClientRect();
        const x = clientX - left;
        const y = clientY - top;
        const s = states[i];
        
        const isNear = x >= -MAX_RADIUS && x <= width + MAX_RADIUS && 
                       y >= -MAX_RADIUS && y <= height + MAX_RADIUS;
        
        if (isNear) {
          // Update cursor position
          el.style.setProperty('--x', `${x}px`);
          el.style.setProperty('--y', `${y}px`);
          
          // On first enter, start radius growth from 0
          if (!s.hasEntered) {
            s.hasEntered = true;
            s.currRadius = 0;
            s.targetRadius = MAX_RADIUS;
          }
          
          s.targetOpacity = 1;
        } else {
          s.targetOpacity = 0;
          s.targetRadius = 0;
          s.hasEntered = false;
        }
      });
      
      if (!rafId) rafId = requestAnimationFrame(animate);
    }, { passive: true });
    
    heading.addEventListener('mouseleave', () => {
      states.forEach(s => {
        s.targetOpacity = 0;
        s.targetRadius = 0;
        s.hasEntered = false;
      });
      if (!rafId) rafId = requestAnimationFrame(animate);
    });
  }

</script>

<section class="hero" data-snap-section>
  <div class="heading">
    <h1 class="heading-text">
      <span class="fm" data-text="FM">FM</span><span class="web" data-text="WEB">WEB</span><span class="dev" data-text="DEV">DEV</span>
    </h1>
    <p class="heading-subtext">Interactive web development</p>
  </div>
  <a class="cta-text" href="#about">Discover more</a>
</section>
