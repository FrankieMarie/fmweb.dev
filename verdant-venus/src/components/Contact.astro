---
import SectionHeading from "./SectionHeading.astro";
---

<style>
  .contact {
    height: calc(100vh - 7.75rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    padding-bottom: 8rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    max-width: 600px;
    width: 100%;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .glowing-btn {
    position: relative;
    color: var(--gold);
    cursor: pointer;
    padding: 0.35em 1em;
    border: 0.15em solid var(--gold);
    border-radius: 0.45em;
    background: none;
    perspective: 2em;
    font-size: 2em;
    font-weight: 900;
    letter-spacing: 1em;

    -webkit-box-shadow: inset 0px 0px 0.5em 0px var(--gold),
      0px 0px 0.5em 0px var(--gold);
    -moz-box-shadow: inset 0px 0px 0.5em 0px var(--gold),
      0px 0px 0.5em 0px var(--gold);
    box-shadow: inset 0px 0px 0.5em 0px var(--gold),
      0px 0px 0.5em 0px var(--gold);
    animation: border-flicker 2s linear infinite;
  }

.glowing-txt {
  float: left;
  margin-right: -0.8em;
  -webkit-text-shadow: 0 0 0.125em hsl(0 0% 100% / 0.3),
    0 0 0.45em var(--gold);
  -moz-text-shadow: 0 0 0.125em hsl(0 0% 100% / 0.3),
    0 0 0.45em var(--gold);
  text-shadow: 0 0 0.125em hsl(0 0% 100% / 0.3), 0 0 0.45em var(--gold);
  animation: text-flicker 3s linear infinite;
}

.faulty-letter {
  opacity: 0.5;
  animation: faulty-flicker 2s linear infinite;
}

.glowing-btn::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  opacity: 0.7;
  filter: blur(1em);
  transform: translateY(120%) rotateX(95deg) scale(1, 0.35);
  background: var(--gold);
  pointer-events: none;
}

.glowing-btn::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  z-index: -1;
  box-shadow: 0 0 1em 0.2em var(--gold);
  transition: opacity 100ms linear;
}

.glowing-btn:hover {
  color: rgba(252, 191, 73);
  text-shadow: none;
  animation: none;
}

.glowing-btn:hover .glowing-txt {
  animation: none;
}

.glowing-btn:hover .faulty-letter {
  animation: none;
  opacity: 1;
}

.glowing-btn:hover:before {
  filter: blur(1.5em);
  opacity: 1;
}

.glowing-btn:hover:after {
  opacity: 1;
}

@keyframes faulty-flicker {
  0% {
    opacity: 0.1;
  }
  2% {
    opacity: 0.1;
  }
  4% {
    opacity: 0.5;
  }
  19% {
    opacity: 0.5;
  }
  21% {
    opacity: 0.1;
  }
  23% {
    opacity: 1;
  }
  80% {
    opacity: 0.5;
  }
  83% {
    opacity: 0.4;
  }

  87% {
    opacity: 1;
  }
}

@keyframes text-flicker {
  0% {
    opacity: 0.1;
  }

  2% {
    opacity: 1;
  }

  8% {
    opacity: 0.1;
  }

  9% {
    opacity: 1;
  }

  12% {
    opacity: 0.1;
  }
  20% {
    opacity: 1;
  }
  25% {
    opacity: 0.3;
  }
  30% {
    opacity: 1;
  }

  70% {
    opacity: 0.7;
  }
  72% {
    opacity: 0.2;
  }

  77% {
    opacity: 0.9;
  }
  100% {
    opacity: 0.9;
  }
}

@keyframes border-flicker {
  0% {
    opacity: 0.1;
  }
  2% {
    opacity: 1;
  }
  4% {
    opacity: 0.1;
  }

  8% {
    opacity: 1;
  }
  70% {
    opacity: 0.7;
  }
  100% {
    opacity: 1;
  }
}

@media only screen and (max-width: 600px) {
  .glowing-btn{
    font-size: 1em;
  }
}

</style> 

<section class="content-container contact">
  <SectionHeading text="Contact" style={{'margin': '8rem 0 4rem 0'}}/>
  <form class="form">
    <input name="name" autocomplete="name" placeholder="Name"/>
    <input name="email" autocomplete="email" placeholder="Email"/>
    <textarea name="message" placeholder="Message"/>
  </form>
  <button class='glowing-btn'>
    <span class='glowing-txt'>S<span class='faulty-letter'>E</span>ND</span>
  </button>
</section>