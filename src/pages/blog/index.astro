---
import { getCollection } from "astro:content";
import BlogCard from "../../components/Blog/BlogCard.astro";
import Page from "../../layouts/Page.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTopics = [...new Set(posts.flatMap((post) => post.data.topics))].sort();
---

<style>
  .intro-paragraph {
    max-width: 37.5rem;
    text-align: center;
    margin: 0 auto;
    width: 100%;
    font-size: 1.25rem;
    margin-top: 4rem;
  }

  section {
    margin: 4rem 0;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 4rem;
  }

  .pill {
    padding: 0.35rem 1rem;
    border-radius: 999px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .blogs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
    gap: 2rem;

    li {
      height: 100%;
    }
  }
  
  @media (max-width: 900px) {
    .blogs {
      grid-template-columns: 1fr;
    }
  }
</style>

<Page
  title="FM Web Blog"
  description="Mostly documentation for myself, but maybe it will help or interest someone."
>
<div class="blog-container">
  <p class="intro-paragraph">This is mostly documentation for myself, but maybe someone will find it helpful or interesting. If you stumbled upon it, welcome.</p>
    <div class="pills">
      {allTopics.map((tag) => (
        <a class="pill" href={`/blog/tag/${tag}`}>{tag}</a>
      ))}
    </div>
    <section>
      <ul class="blogs">
        {
          posts.map((post) => (
            <li>
              <BlogCard post={post} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Page>
