---
import { ArrowDown } from "@lucide/astro";
import SectionHeading from "./SectionHeading.astro";
---

<style>
  .hero {
    height: calc(100vh - 7.75rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }

  .h1 {
    margin-bottom: 2rem;
  }

  .heading-text {
    color: var(--white);
    text-transform: uppercase;
    width: 100%;
    font-size: clamp(3rem, 5vw, 15rem);
    font-weight: 900;
    letter-spacing: .025em;
    text-align: center;
  }

  .heading-subtext {
    font-size: clamp(1rem, 2vw, 2rem);
    text-align: center;
    color: var(--grey);

  }

  .scramble-typewriter {
    font-weight: 200;
    color: var(--grey);
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .cta-text {
    font-weight: 200;
    color: var(--grey);
    letter-spacing: .15em;
    text-transform: uppercase;
    font-size: .85rem;
  } 

  .cta-btn {
    margin: 1rem 0 2rem 0;
    background: none;
    border: none;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--gold);
    color: var(--bg);
    border-radius: 4px;
    padding: .15rem .25rem;
  }
</style> 

<script src="./scramble-type.ts"></script>

<section class="content-container hero">
  <div class="heading">
    <h1 class="heading-text">
      Hi, I'm{' '}
      <span class="blink-text">FR<span class="faulty-letter">A</span>NKIE</span>
    </h1>
    <p class="heading-subtext">I build websites and web applications</p>
  </div>
  <span class="cta-text">Discover More</span>
  <a href="#about" class="cta-btn"><ArrowDown/></a>  
</section>
